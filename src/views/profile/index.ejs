<div class="max-w-3xl mx-auto space-y-6">
  
  <!-- Info & Avatar Card -->
  <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 p-6 flex flex-col md:flex-row items-center gap-6 relative">
    <!-- Logout Button -->
    <form action="/api/auth/logout" method="POST" class="absolute top-6 right-6">
      <button type="submit" class="text-sm font-medium text-red-500 hover:text-red-700 flex items-center transition-colors">
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
        Keluar
      </button>
    </form>

    <div class="relative group">
      <div class="w-24 h-24 rounded-full border-4 border-gray-50 dark:border-gray-700 overflow-hidden shadow-sm">
        <img id="avatarImage" src="<%= userData.avatar %>" alt="Avatar" class="w-full h-full object-cover">
      </div>
      <label for="avatarUpload" class="absolute bottom-0 right-0 bg-accent hover:bg-blue-600 text-white p-2 rounded-full cursor-pointer shadow-md transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
      </label>
      <input type="file" id="avatarUpload" accept="image/png, image/jpeg, image/webp" class="hidden">
    </div>

    <div class="text-center md:text-left">
      <h2 class="text-2xl font-bold text-gray-800 dark:text-white" id="displayFullName"><%= userData.fullName %></h2>
      <p class="text-sm text-gray-500 dark:text-gray-400">@<%= userData.username %></p>
      <span class="inline-block mt-2 px-3 py-1 bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300 text-xs font-bold rounded-full uppercase">
        <%= userData.role === 'admin' ? 'Administrator' : 'Member' %>
      </span>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- Edit Profil Form -->
    <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 p-6">
      <h3 class="text-lg font-bold mb-4">Informasi Dasar</h3>
      <form id="profileForm" class="space-y-4">
        <div>
          <label class="block text-sm font-medium mb-1.5 text-gray-700 dark:text-gray-300">Nama Lengkap</label>
          <input type="text" id="fullName" value="<%= userData.fullName %>" required
            class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 focus:ring-2 focus:ring-accent outline-none">
        </div>
        <div>
          <label class="block text-sm font-medium mb-1.5 text-gray-700 dark:text-gray-300">Email (Tidak bisa diubah)</label>
          <input type="email" value="<%= userData.email %>" disabled
            class="w-full px-4 py-3 rounded-xl bg-gray-100 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-500 cursor-not-allowed outline-none">
        </div>
        <div>
          <label class="block text-sm font-medium mb-1.5 text-gray-700 dark:text-gray-300">Nomor HP / WhatsApp</label>
          <input type="tel" id="phone" value="<%= userData.phone %>"
            class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 focus:ring-2 focus:ring-accent outline-none">
        </div>
        <button type="submit" id="btnUpdateProfile" class="w-full py-3 bg-gray-900 dark:bg-gray-100 text-white dark:text-gray-900 rounded-xl font-medium shadow-sm transition-all hover:bg-gray-800 dark:hover:bg-gray-200">
          Simpan Perubahan
        </button>
      </form>
    </div>

    <!-- Ubah Password Form -->
    <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 p-6">
      <h3 class="text-lg font-bold mb-4">Keamanan Akun</h3>
      <form id="passwordForm" class="space-y-4">
        <div>
          <label class="block text-sm font-medium mb-1.5 text-gray-700 dark:text-gray-300">Password Lama</label>
          <input type="password" id="oldPassword" required
            class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 focus:ring-2 focus:ring-accent outline-none">
        </div>
        <div>
          <label class="block text-sm font-medium mb-1.5 text-gray-700 dark:text-gray-300">Password Baru</label>
          <input type="password" id="newPassword" required minlength="8"
            class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 focus:ring-2 focus:ring-accent outline-none">
        </div>
        <button type="submit" id="btnUpdatePassword" class="w-full py-3 bg-gray-900 dark:bg-gray-100 text-white dark:text-gray-900 rounded-xl font-medium shadow-sm transition-all hover:bg-gray-800 dark:hover:bg-gray-200">
          Perbarui Password
        </button>
      </form>
    </div>
  </div>
</div>

<script>
  // Handle Update Profile
  document.getElementById('profileForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('btnUpdateProfile');
    btn.disabled = true;
    btn.innerText = 'Menyimpan...';

    const payload = {
      fullName: document.getElementById('fullName').value,
      phone: document.getElementById('phone').value
    };

    try {
      const res = await axios.post('/api/profile/update', payload);
      if (res.data.success) {
        showToast('success', res.data.data.message);
        document.getElementById('displayFullName').innerText = payload.fullName;
      }
    } catch (error) {
      showToast('error', error.response?.data?.error?.message || 'Gagal menyimpan profil.');
    } finally {
      btn.disabled = false;
      btn.innerText = 'Simpan Perubahan';
    }
  });

  // Handle Update Password
  document.getElementById('passwordForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('btnUpdatePassword');
    btn.disabled = true;
    btn.innerText = 'Memproses...';

    const payload = {
      oldPassword: document.getElementById('oldPassword').value,
      newPassword: document.getElementById('newPassword').value
    };

    try {
      const res = await axios.post('/api/profile/password', payload);
      if (res.data.success) {
        showToast('success', res.data.data.message);
        document.getElementById('passwordForm').reset();
      }
    } catch (error) {
      showToast('error', error.response?.data?.error?.message || 'Gagal mengubah password.');
    } finally {
      btn.disabled = false;
      btn.innerText = 'Perbarui Password';
    }
  });

  // Handle Avatar Upload dengan Base64 (Tanpa Multer)
  document.getElementById('avatarUpload').addEventListener('change', async (e) => {
    const file = e.target.files[0];
    if (!file) return;

    if (file.size > 2 * 1024 * 1024) {
      return showToast('error', 'Ukuran gambar maksimal 2MB.');
    }

    const reader = new FileReader();
    reader.onload = async (event) => {
      const base64String = event.target.result;
      const extension = file.name.split('.').pop();
      
      showToast('info', 'Mengunggah avatar ke server...');

      try {
        const res = await axios.post('/api/profile/avatar', { base64Image: base64String, extension });
        if (res.data.success) {
          document.getElementById('avatarImage').src = res.data.data.avatarUrl;
          showToast('success', 'Avatar berhasil diperbarui!');
        }
      } catch (error) {
        showToast('error', error.response?.data?.error?.message || 'Gagal mengunggah avatar.');
      }
    };
    
    reader.readAsDataURL(file);
  });
</script>