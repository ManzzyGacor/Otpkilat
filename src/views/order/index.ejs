<div class="max-w-2xl mx-auto">
  <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 p-6 mb-6">
    <h2 class="text-xl font-bold mb-1">Pesan Nomor OTP</h2>
    <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">Pilih layanan dan negara yang Anda butuhkan.</p>

    <!-- Form Order -->
    <div id="orderFormContainer" class="space-y-5">
      
      <!-- Pilih Layanan -->
      <div>
        <label class="block text-sm font-medium mb-1.5 text-gray-700 dark:text-gray-300">Layanan Aplikasi</label>
        <select id="serviceSelect" class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 focus:ring-2 focus:ring-accent outline-none appearance-none disabled:opacity-50">
          <option value="" selected disabled>Memuat layanan...</option>
        </select>
      </div>

      <!-- Pilih Negara -->
      <div>
        <label class="block text-sm font-medium mb-1.5 text-gray-700 dark:text-gray-300">Negara</label>
        <select id="countrySelect" disabled class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 focus:ring-2 focus:ring-accent outline-none appearance-none disabled:opacity-50">
          <option value="" selected disabled>Pilih layanan terlebih dahulu</option>
        </select>
      </div>

      <!-- Pilih Operator -->
      <div>
        <label class="block text-sm font-medium mb-1.5 text-gray-700 dark:text-gray-300">Operator</label>
        <select id="operatorSelect" disabled class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 focus:ring-2 focus:ring-accent outline-none appearance-none disabled:opacity-50">
          <option value="any" selected>Any (Acak)</option>
        </select>
      </div>

      <!-- Informasi Harga (Hanya Estimasi, Final di Backend) -->
      <div id="priceInfo" class="hidden bg-blue-50 dark:bg-blue-900/20 p-4 rounded-xl border border-blue-100 dark:border-blue-800 flex justify-between items-center">
        <span class="text-sm text-blue-800 dark:text-blue-300 font-medium">Estimasi Harga:</span>
        <span id="priceDisplay" class="font-bold text-lg text-blue-900 dark:text-blue-200">Rp0</span>
      </div>

      <button id="btnOrder" disabled class="w-full py-3 px-4 bg-accent hover:bg-blue-600 text-white rounded-xl font-medium shadow-sm transition-all flex justify-center items-center disabled:opacity-50 disabled:cursor-not-allowed">
        Pesan Sekarang
      </button>
    </div>

    <!-- Tampilan OTP (Disembunyikan secara default) -->
    <div id="otpDisplayContainer" class="hidden space-y-6">
      <div class="text-center">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-blue-100 dark:bg-blue-900 text-accent mb-4">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
        </div>
        <h3 class="text-lg font-bold" id="displayService">Layanan</h3>
        <p class="text-sm text-gray-500" id="displayCountry">Negara</p>
      </div>

      <div class="bg-gray-50 dark:bg-gray-900 rounded-2xl p-4 border border-gray-200 dark:border-gray-700 text-center relative">
        <p class="text-xs text-gray-500 mb-1 uppercase tracking-wider font-semibold">Nomor Virtual</p>
        <div class="flex items-center justify-center space-x-3">
          <h2 class="text-2xl font-bold tracking-widest text-gray-800 dark:text-gray-100" id="displayNumber">...</h2>
          <button onclick="copyText('displayNumber')" class="text-accent hover:text-blue-700 bg-blue-50 dark:bg-blue-900/30 p-2 rounded-lg transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
          </button>
        </div>
      </div>

      <div class="bg-blue-50 dark:bg-blue-900/20 rounded-2xl p-6 border border-blue-200 dark:border-blue-800 text-center">
        <p class="text-xs text-blue-600 dark:text-blue-300 mb-2 uppercase tracking-wider font-semibold" id="otpStatusText">Menunggu OTP...</p>
        <div class="flex items-center justify-center space-x-3">
          <h1 class="text-4xl font-extrabold text-blue-900 dark:text-blue-100 tracking-widest" id="displayOtp">- - - - - -</h1>
          <button id="btnCopyOtp" onclick="copyText('displayOtp')" class="hidden text-accent hover:text-blue-700 bg-white dark:bg-gray-800 p-2 rounded-lg shadow-sm transition-colors border border-gray-200 dark:border-gray-700">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
          </button>
        </div>
        <p class="text-sm text-gray-500 mt-4" id="otpMessageDisplay"></p>
      </div>

      <div class="flex space-x-3">
        <button id="btnCancelOrder" class="flex-1 py-3 px-4 bg-red-50 text-red-600 border border-red-200 hover:bg-red-100 dark:bg-red-900/20 dark:border-red-800 dark:text-red-400 rounded-xl font-medium transition-all">
          Batalkan
        </button>
        <button id="btnOrderDone" class="hidden flex-1 py-3 px-4 bg-green-500 hover:bg-green-600 text-white rounded-xl font-medium shadow-sm transition-all">
          Selesai
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  let activeOrderId = null;
  let pollingInterval = null;
  let selectedProviderId = null;
  let selectedNumberId = null;

  const els = {
    service: document.getElementById('serviceSelect'),
    country: document.getElementById('countrySelect'),
    operator: document.getElementById('operatorSelect'),
    priceInfo: document.getElementById('priceInfo'),
    priceDisplay: document.getElementById('priceDisplay'),
    btnOrder: document.getElementById('btnOrder'),
    formContainer: document.getElementById('orderFormContainer'),
    otpContainer: document.getElementById('otpDisplayContainer'),
    displayService: document.getElementById('displayService'),
    displayCountry: document.getElementById('displayCountry'),
    displayNumber: document.getElementById('displayNumber'),
    displayOtp: document.getElementById('displayOtp'),
    otpStatusText: document.getElementById('otpStatusText'),
    otpMessageDisplay: document.getElementById('otpMessageDisplay'),
    btnCopyOtp: document.getElementById('btnCopyOtp'),
    btnCancel: document.getElementById('btnCancelOrder'),
    btnDone: document.getElementById('btnOrderDone')
  };

  // Muat layanan saat halaman dibuka
  async function loadServices() {
    try {
      // API Backend Proxy yang harus dibuat di rute /api/provider/services
      const res = await axios.get('/api/provider/services'); 
      if(res.data.success) {
        els.service.innerHTML = '<option value="" selected disabled>Pilih Layanan</option>';
        res.data.data.forEach(s => {
          els.service.innerHTML += `<option value="${s.service_code}" data-name="${s.service_name}">${s.service_name}</option>`;
        });
        els.service.disabled = false;
      }
    } catch (e) {
      showToast('error', 'Gagal memuat layanan');
    }
  }

  // Load negara saat layanan dipilih
  els.service.addEventListener('change', async (e) => {
    els.country.disabled = true;
    els.country.innerHTML = '<option>Memuat negara...</option>';
    els.btnOrder.disabled = true;
    els.priceInfo.classList.add('hidden');

    try {
      const res = await axios.get(`/api/provider/countries?service_id=${e.target.value}`);
      if(res.data.success) {
        els.country.innerHTML = '<option value="" selected disabled>Pilih Negara</option>';
        // Simpan data negara di memori lokal sementara
        window.countryDataList = res.data.data; 
        res.data.data.forEach(c => {
          els.country.innerHTML += `<option value="${c.number_id}">${c.name}</option>`;
        });
        els.country.disabled = false;
      }
    } catch (err) {
      showToast('error', 'Gagal memuat negara');
    }
  });

  // Ekstrak harga saat negara dipilih
  els.country.addEventListener('change', (e) => {
    const selectedCountryId = e.target.value;
    const countryObj = window.countryDataList.find(c => String(c.number_id) === String(selectedCountryId));
    
    if(countryObj && countryObj.pricelist && countryObj.pricelist.length > 0) {
      // Ambil harga dari provider pertama di daftar (bisa dikembangkan untuk multi-provider)
      const provider = countryObj.pricelist[0];
      selectedProviderId = provider.provider_id;
      selectedNumberId = countryObj.number_id;
      
      els.priceDisplay.innerText = provider.price_format;
      els.priceInfo.classList.remove('hidden');
      
      els.operator.disabled = false;
      els.btnOrder.disabled = false;
    } else {
      showToast('warning', 'Stok kosong untuk negara ini.');
      els.btnOrder.disabled = true;
    }
  });

  // Handle pemesanan
  els.btnOrder.addEventListener('click', async () => {
    els.btnOrder.innerHTML = 'Memproses...';
    els.btnOrder.disabled = true;

    const payload = {
      numberId: selectedNumberId,
      providerId: selectedProviderId,
      operatorId: els.operator.value,
      serviceName: els.service.options[els.service.selectedIndex].getAttribute('data-name'),
      countryName: els.country.options[els.country.selectedIndex].text
    };

    try {
      const res = await axios.post('/api/order/create', payload);
      if(res.data.success) {
        showToast('success', 'Pesanan berhasil dibuat!');
        activeOrderId = res.data.data.orderId;
        
        els.displayService.innerText = res.data.data.service;
        els.displayCountry.innerText = res.data.data.country;
        els.displayNumber.innerText = res.data.data.phoneNumber;
        
        els.formContainer.classList.add('hidden');
        els.otpContainer.classList.remove('hidden');
        
        startPolling(activeOrderId);
      }
    } catch (error) {
      showToast('error', error.response?.data?.error?.message || 'Gagal memproses pesanan.');
      els.btnOrder.innerHTML = 'Pesan Sekarang';
      els.btnOrder.disabled = false;
    }
  });

  // Polling OTP Status
  function startPolling(orderId) {
    if (pollingInterval) clearInterval(pollingInterval);
    
    // Polling setiap 3 detik
    pollingInterval = setInterval(async () => {
      try {
        const res = await axios.get(`/api/order/status/${orderId}`);
        if(res.data.success) {
          const order = res.data.data;
          
          if(order.otpCode) {
            els.displayOtp.innerText = order.otpCode;
            els.otpStatusText.innerText = 'OTP Diterima!';
            els.otpStatusText.classList.replace('text-blue-600', 'text-green-600');
            els.btnCopyOtp.classList.remove('hidden');
            els.btnDone.classList.remove('hidden');
            
            if(order.otpMsg) {
              els.otpMessageDisplay.innerText = order.otpMsg;
            }
          }

          if(order.status === 'completed' || order.status === 'canceled') {
            clearInterval(pollingInterval);
            if(order.status === 'canceled') {
              showToast('error', 'Pesanan dibatalkan atau kadaluarsa.');
              setTimeout(() => location.reload(), 2000);
            }
          }
        }
      } catch (e) {
        console.error('Polling error', e);
      }
    }, 3000);
  }

  // Handle Cancel
  els.btnCancel.addEventListener('click', async () => {
    if(!activeOrderId) return;
    try {
      const res = await axios.post(`/api/order/set-status/${activeOrderId}`, { status: 'cancel' });
      if(res.data.success) {
        showToast('success', 'Permintaan pembatalan dikirim.');
        els.btnCancel.innerText = 'Membatalkan...';
        els.btnCancel.disabled = true;
      }
    } catch (error) {
      showToast('error', 'Gagal membatalkan pesanan.');
    }
  });

  // Utilitas Copy Text
  function copyText(elementId) {
    const text = document.getElementById(elementId).innerText;
    navigator.clipboard.writeText(text).then(() => {
      showToast('success', 'Disalin ke clipboard!');
    });
  }

  // Init
  document.addEventListener('DOMContentLoaded', loadServices);
</script>