<div class="max-w-5xl mx-auto space-y-6">
  
  <!-- Header Admin -->
  <div class="bg-gray-900 rounded-3xl p-6 shadow-sm flex flex-col md:flex-row justify-between items-center text-white relative overflow-hidden">
    <div class="absolute -right-10 -bottom-10 w-48 h-48 bg-white opacity-5 rounded-full blur-3xl"></div>
    <div class="relative z-10 text-center md:text-left mb-4 md:mb-0">
      <h2 class="text-2xl font-bold tracking-tight">Admin Dashboard</h2>
      <p class="text-gray-400 text-sm mt-1">Pusat kendali KilatOTP.</p>
    </div>
    <div class="relative z-10 flex space-x-3">
      <a href="/admin/users" class="bg-gray-800 border border-gray-700 hover:bg-gray-700 text-white px-4 py-2 rounded-xl text-sm font-medium transition-colors">
        Kelola User
      </a>
      <a href="/admin/settings" class="bg-accent hover:bg-blue-600 text-white px-4 py-2 rounded-xl text-sm font-medium transition-colors">
        Pengaturan
      </a>
    </div>
  </div>

  <!-- Quick Stats Grid -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
    <div class="bg-white dark:bg-gray-800 p-5 rounded-3xl border border-gray-100 dark:border-gray-700 shadow-sm flex flex-col">
      <span class="text-gray-500 dark:text-gray-400 text-xs font-semibold uppercase tracking-wider mb-2">Total User</span>
      <span class="text-2xl font-bold text-gray-800 dark:text-gray-100" id="statUsers">Memuat...</span>
    </div>
    <div class="bg-white dark:bg-gray-800 p-5 rounded-3xl border border-gray-100 dark:border-gray-700 shadow-sm flex flex-col">
      <span class="text-gray-500 dark:text-gray-400 text-xs font-semibold uppercase tracking-wider mb-2">Order Aktif</span>
      <span class="text-2xl font-bold text-accent" id="statOrders">Memuat...</span>
    </div>
    <div class="bg-white dark:bg-gray-800 p-5 rounded-3xl border border-gray-100 dark:border-gray-700 shadow-sm flex flex-col">
      <span class="text-gray-500 dark:text-gray-400 text-xs font-semibold uppercase tracking-wider mb-2">Saldo Provider</span>
      <span class="text-2xl font-bold text-green-600 dark:text-green-400" id="statProviderBal">Memuat...</span>
    </div>
    <div class="bg-white dark:bg-gray-800 p-5 rounded-3xl border border-gray-100 dark:border-gray-700 shadow-sm flex flex-col">
      <span class="text-gray-500 dark:text-gray-400 text-xs font-semibold uppercase tracking-wider mb-2">Profit (Bulan Ini)</span>
      <span class="text-2xl font-bold text-blue-600 dark:text-blue-400" id="statProfit">Memuat...</span>
    </div>
  </div>

  <!-- Live Transaction Logs -->
  <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
    <div class="p-6 border-b border-gray-100 dark:border-gray-700 flex justify-between items-center">
      <h3 class="font-bold text-lg text-gray-800 dark:text-gray-100">Log Transaksi & Mutasi Sistem</h3>
      <button onclick="loadTransactionLogs()" class="text-accent hover:text-blue-700 p-2 bg-blue-50 dark:bg-blue-900/30 rounded-lg transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
      </button>
    </div>
    
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-gray-50 dark:bg-gray-900/50 text-gray-500 dark:text-gray-400 text-xs uppercase tracking-wider">
            <th class="p-4 font-semibold">Waktu</th>
            <th class="p-4 font-semibold">User</th>
            <th class="p-4 font-semibold">Tipe</th>
            <th class="p-4 font-semibold">Nominal</th>
            <th class="p-4 font-semibold">Deskripsi</th>
          </tr>
        </thead>
        <tbody id="logsTableBody" class="divide-y divide-gray-100 dark:divide-gray-700 text-sm">
          <tr>
            <td colspan="5" class="p-8 text-center text-gray-500">Memuat log transaksi...</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  async function loadTransactionLogs() {
    const tbody = document.getElementById('logsTableBody');
    tbody.innerHTML = '<tr><td colspan="5" class="p-8 text-center text-gray-500"><svg class="animate-spin h-5 w-5 mx-auto text-accent" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg></td></tr>';

    try {
      const res = await axios.get('/admin/api/transactions/logs?limit=20');
      if (res.data.success && res.data.data.length > 0) {
        tbody.innerHTML = '';
        res.data.data.forEach(log => {
          const date = new Date(log.createdAt).toLocaleString('id-ID');
          let typeStyle = 'bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-300';
          let amountStyle = log.amount > 0 ? 'text-green-600 dark:text-green-400' : 'text-red-600 dark:text-red-400';

          if (log.type === 'deposit') typeStyle = 'bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300';
          if (log.type === 'order') typeStyle = 'bg-purple-100 text-purple-700 dark:bg-purple-900/30 dark:text-purple-300';
          if (log.type === 'adjustment') typeStyle = 'bg-yellow-100 text-yellow-700 dark:bg-yellow-900/30 dark:text-yellow-400';

          tbody.innerHTML += `
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors">
              <td class="p-4 text-xs text-gray-500 whitespace-nowrap">${date}</td>
              <td class="p-4 font-medium text-gray-800 dark:text-gray-200">
                ${log.userId ? log.userId.username : 'Sistem'}
              </td>
              <td class="p-4">
                <span class="px-2 py-1 rounded text-xs font-bold uppercase ${typeStyle}">${log.type}</span>
              </td>
              <td class="p-4 font-bold ${amountStyle} whitespace-nowrap">
                ${log.amount > 0 ? '+' : ''}Rp${Math.abs(log.amount).toLocaleString('id-ID')}
              </td>
              <td class="p-4 text-gray-600 dark:text-gray-400 text-xs">${log.description}</td>
            </tr>
          `;
        });
      } else {
        tbody.innerHTML = '<tr><td colspan="5" class="p-8 text-center text-gray-500">Belum ada log transaksi.</td></tr>';
      }
    } catch (error) {
      tbody.innerHTML = '<tr><td colspan="5" class="p-8 text-center text-red-500">Gagal memuat log transaksi.</td></tr>';
    }
  }

  // Auto load saat halaman dibuka
  document.addEventListener('DOMContentLoaded', loadTransactionLogs);
</script>