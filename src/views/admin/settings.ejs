<div class="max-w-4xl mx-auto space-y-6">
  
  <!-- Form Pengaturan Umum & Margin -->
  <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 p-6">
    <h2 class="text-xl font-bold mb-1">Pengaturan & Margin Profit</h2>
    <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">Atur margin harga jual dan batas transaksi platform.</p>

    <form id="settingsForm" class="space-y-4">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium mb-1.5 text-gray-700 dark:text-gray-300">Nama Website</label>
          <input type="text" id="websiteName" value="<%= settings.websiteName %>" required
            class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 focus:ring-2 focus:ring-accent outline-none">
        </div>

        <div>
          <label class="block text-sm font-medium mb-1.5 text-gray-700 dark:text-gray-300">Tipe Margin Profit</label>
          <select id="marginType" class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 focus:ring-2 focus:ring-accent outline-none">
            <option value="percentage" <%= settings.marginType === 'percentage' ? 'selected' : '' %>>Persentase (%)</option>
            <option value="fixed" <%= settings.marginType === 'fixed' ? 'selected' : '' %>>Nominal Tetap (Rp)</option>
          </select>
        </div>

        <div>
          <label class="block text-sm font-medium mb-1.5 text-gray-700 dark:text-gray-300">Nilai Margin</label>
          <input type="number" id="marginValue" value="<%= settings.marginValue %>" required step="any"
            class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 focus:ring-2 focus:ring-accent outline-none">
        </div>

        <div>
          <label class="block text-sm font-medium mb-1.5 text-gray-700 dark:text-gray-300">Mode Pemeliharaan (Maintenance)</label>
          <select id="maintenanceMode" class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 focus:ring-2 focus:ring-accent outline-none">
            <option value="false" <%= !settings.maintenanceMode ? 'selected' : '' %>>Tidak Aktif (Normal)</option>
            <option value="true" <%= settings.maintenanceMode ? 'selected' : '' %>>Aktif (Maintenance)</option>
          </select>
        </div>

        <div>
          <label class="block text-sm font-medium mb-1.5 text-gray-700 dark:text-gray-300">Minimum Deposit (Rp)</label>
          <input type="number" id="minimumDeposit" value="<%= settings.minimumDeposit %>" required
            class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 focus:ring-2 focus:ring-accent outline-none">
        </div>

        <div>
          <label class="block text-sm font-medium mb-1.5 text-gray-700 dark:text-gray-300">Maximum Deposit (Rp)</label>
          <input type="number" id="maximumDeposit" value="<%= settings.maximumDeposit %>" required
            class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 focus:ring-2 focus:ring-accent outline-none">
        </div>
      </div>

      <button type="submit" id="btnSaveSettings" class="w-full py-3 bg-accent hover:bg-blue-600 text-white rounded-xl font-medium shadow-sm transition-all mt-4">
        Simpan Pengaturan
      </button>
    </form>
  </div>

  <!-- Manajemen Pengumuman (Announcement) -->
  <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 p-6">
    <h3 class="text-lg font-bold mb-4">Buat Pengumuman Baru</h3>
    <form id="announcementForm" class="space-y-4 mb-8 pb-8 border-b border-gray-100 dark:border-gray-700">
      <div>
        <label class="block text-sm font-medium mb-1.5 text-gray-700 dark:text-gray-300">Judul Pengumuman</label>
        <input type="text" id="annTitle" required placeholder="Contoh: Pemeliharaan Server Provider"
          class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 focus:ring-2 focus:ring-accent outline-none">
      </div>
      <div>
        <label class="block text-sm font-medium mb-1.5 text-gray-700 dark:text-gray-300">Tipe Badge</label>
        <select id="annType" class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 focus:ring-2 focus:ring-accent outline-none">
          <option value="info">Info (Biru)</option>
          <option value="success">Success (Hijau)</option>
          <option value="warning">Warning (Kuning)</option>
          <option value="danger">Danger (Merah)</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium mb-1.5 text-gray-700 dark:text-gray-300">Konten Pesan</label>
        <textarea id="annContent" required rows="3" placeholder="Isi detail pengumuman di sini..."
          class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 focus:ring-2 focus:ring-accent outline-none"></textarea>
      </div>
      <button type="submit" id="btnCreateAnn" class="w-full py-3 bg-gray-900 dark:bg-gray-100 text-white dark:text-gray-900 rounded-xl font-medium shadow-sm transition-all hover:bg-gray-800">
        Publikasikan Pengumuman
      </button>
    </form>

    <h3 class="text-lg font-bold mb-4">Daftar Pengumuman Aktif</h3>
    <div class="space-y-3">
      <% if (announcements && announcements.length > 0) { %>
        <% announcements.forEach(function(ann) { %>
          <div class="p-4 rounded-2xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900/50 flex justify-between items-start">
            <div>
              <div class="flex items-center space-x-2 mb-1">
                <span class="text-xs font-bold px-2 py-0.5 rounded uppercase 
                  <%= ann.type === 'info' ? 'bg-blue-100 text-blue-700 dark:bg-blue-900 dark:text-blue-300' : '' %>
                  <%= ann.type === 'success' ? 'bg-green-100 text-green-700 dark:bg-green-900 dark:text-green-300' : '' %>
                  <%= ann.type === 'warning' ? 'bg-yellow-100 text-yellow-700 dark:bg-yellow-900 dark:text-yellow-300' : '' %>
                  <%= ann.type === 'danger' ? 'bg-red-100 text-red-700 dark:bg-red-900 dark:text-red-300' : '' %>
                "><%= ann.type %></span>
                <h4 class="font-bold text-sm text-gray-800 dark:text-gray-200"><%= ann.title %></h4>
              </div>
              <p class="text-xs text-gray-600 dark:text-gray-400"><%= ann.content %></p>
            </div>
            <button onclick="deleteAnnouncement('<%= ann._id %>')" class="text-red-500 hover:text-red-700 p-2 text-xs font-medium">
              Hapus
            </button>
          </div>
        <% }); %>
      <% } else { %>
        <p class="text-sm text-gray-500 text-center py-4">Belum ada pengumuman aktif.</p>
      <% } %>
    </div>
  </div>
</div>

<script>
  // Handle Save Settings
  document.getElementById('settingsForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('btnSaveSettings');
    btn.disabled = true;
    btn.innerText = 'Menyimpan...';

    const payload = {
      websiteName: document.getElementById('websiteName').value,
      marginType: document.getElementById('marginType').value,
      marginValue: document.getElementById('marginValue').value,
      minimumDeposit: document.getElementById('minimumDeposit').value,
      maximumDeposit: document.getElementById('maximumDeposit').value,
      maintenanceMode: document.getElementById('maintenanceMode').value
    };

    try {
      const res = await axios.post('/admin/api/settings/update', payload);
      if (res.data.success) {
        showToast('success', res.data.data.message);
        setTimeout(() => location.reload(), 1000);
      }
    } catch (error) {
      showToast('error', error.response?.data?.error?.message || 'Gagal menyimpan pengaturan.');
      btn.disabled = false;
      btn.innerText = 'Simpan Pengaturan';
    }
  });

  // Handle Create Announcement
  document.getElementById('announcementForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('btnCreateAnn');
    btn.disabled = true;
    btn.innerText = 'Mempublikasikan...';

    const payload = {
      title: document.getElementById('annTitle').value,
      type: document.getElementById('annType').value,
      content: document.getElementById('annContent').value
    };

    try {
      const res = await axios.post('/admin/api/announcements/create', payload);
      if (res.data.success) {
        showToast('success', res.data.data.message);
        setTimeout(() => location.reload(), 1000);
      }
    } catch (error) {
      showToast('error', error.response?.data?.error?.message || 'Gagal membuat pengumuman.');
      btn.disabled = false;
      btn.innerText = 'Publikasikan Pengumuman';
    }
  });

  // Handle Delete Announcement
  async function deleteAnnouncement(id) {
    if (!confirm('Yakin ingin menghapus pengumuman ini?')) return;
    try {
      const res = await axios.post(`/admin/api/announcements/delete/${id}`);
      if (res.data.success) {
        showToast('success', res.data.data.message);
        setTimeout(() => location.reload(), 1000);
      }
    } catch (error) {
      showToast('error', 'Gagal menghapus pengumuman.');
    }
  }
</script>