<div class="max-w-5xl mx-auto space-y-6">
  
  <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 p-6">
    <div class="flex flex-col md:flex-row justify-between items-center mb-6 gap-4">
      <div>
        <h2 class="text-xl font-bold text-gray-800 dark:text-gray-100">Manajemen Member</h2>
        <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Cari user dan sesuaikan saldo member.</p>
      </div>
      
      <div class="relative w-full md:w-72">
        <input type="text" id="searchInput" placeholder="Cari username atau nama..." 
          class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 focus:ring-2 focus:ring-accent outline-none text-sm transition-all">
        <svg class="w-4 h-4 text-gray-400 absolute left-4 top-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
      </div>
    </div>

    <!-- Tabel Daftar User -->
    <div class="overflow-x-auto rounded-2xl border border-gray-100 dark:border-gray-700">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-gray-50 dark:bg-gray-900/50 text-gray-500 dark:text-gray-400 text-xs uppercase tracking-wider">
            <th class="p-4 font-semibold">Member</th>
            <th class="p-4 font-semibold">Kontak</th>
            <th class="p-4 font-semibold">Saldo</th>
            <th class="p-4 font-semibold">Status</th>
            <th class="p-4 font-semibold text-center">Aksi</th>
          </tr>
        </thead>
        <tbody id="usersTableBody" class="divide-y divide-gray-100 dark:divide-gray-700 text-sm">
          <tr>
            <td colspan="5" class="p-8 text-center text-gray-500">Ketik untuk mencari user, atau kosongkan untuk melihat semua.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

</div>

<!-- Modal Adjustment Saldo -->
<div id="modalAdjustment" class="fixed inset-0 z-[100] hidden items-center justify-center bg-gray-900/50 backdrop-blur-sm p-4">
  <div class="bg-white dark:bg-gray-800 rounded-3xl p-6 w-full max-w-md shadow-xl border border-gray-100 dark:border-gray-700 scale-95 transition-transform duration-200" id="modalContent">
    <div class="flex justify-between items-center mb-5">
      <h3 class="text-lg font-bold text-gray-800 dark:text-white">Adjustment Saldo</h3>
      <button onclick="closeModal()" class="text-gray-400 hover:text-red-500 transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>
    
    <div class="bg-gray-50 dark:bg-gray-900 p-3 rounded-xl mb-4 text-center border border-gray-200 dark:border-gray-700">
      <p class="text-xs text-gray-500 mb-1">Target Akun</p>
      <p class="font-bold text-accent" id="modalUsername">@username</p>
    </div>

    <form id="formAdjustBalance" class="space-y-4">
      <input type="hidden" id="adjustUserId">
      
      <div>
        <label class="block text-sm font-medium mb-1.5 text-gray-700 dark:text-gray-300">Tipe Aksi</label>
        <select id="adjustAction" class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 focus:ring-2 focus:ring-accent outline-none">
          <option value="add">Tambah Saldo (+)</option>
          <option value="deduct">Potong Saldo (-)</option>
        </select>
      </div>

      <div>
        <label class="block text-sm font-medium mb-1.5 text-gray-700 dark:text-gray-300">Nominal (Rp)</label>
        <input type="number" id="adjustAmount" required min="1" placeholder="Contoh: 50000"
          class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 focus:ring-2 focus:ring-accent outline-none">
      </div>
      
      <div>
        <label class="block text-sm font-medium mb-1.5 text-gray-700 dark:text-gray-300">Catatan/Deskripsi</label>
        <input type="text" id="adjustDesc" required placeholder="Contoh: Kompensasi bug / Hadiah"
          class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 focus:ring-2 focus:ring-accent outline-none">
      </div>

      <button type="submit" id="btnSubmitAdjust" class="w-full py-3 bg-gray-900 dark:bg-gray-100 text-white dark:text-gray-900 rounded-xl font-medium shadow-sm transition-all hover:bg-gray-800 dark:hover:bg-gray-200 mt-2">
        Proses Adjustment
      </button>
    </form>
  </div>
</div>

<script>
  // Fitur Pencarian User
  let searchTimeout = null;
  const searchInput = document.getElementById('searchInput');
  const tbody = document.getElementById('usersTableBody');

  async function fetchUsers(query = '') {
    tbody.innerHTML = '<tr><td colspan="5" class="p-8 text-center text-gray-500">Memuat data...</td></tr>';
    try {
      const res = await axios.get(`/admin/api/users?search=${query}`);
      if (res.data.success && res.data.data.length > 0) {
        tbody.innerHTML = '';
        res.data.data.forEach(u => {
          const roleBadge = u.role === 'admin' 
            ? '<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-blue-100 text-blue-700 dark:bg-blue-900 dark:text-blue-300 uppercase">Admin</span>'
            : '';

          tbody.innerHTML += `
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors">
              <td class="p-4">
                <div class="flex items-center space-x-3">
                  <div class="w-8 h-8 rounded-full bg-gray-200 dark:bg-gray-700 overflow-hidden shrink-0">
                    <img src="${u.avatar || 'https://ui-avatars.com/api/?name='+u.username}" class="w-full h-full object-cover">
                  </div>
                  <div>
                    <div class="font-bold text-gray-800 dark:text-gray-100 text-sm flex items-center gap-2">
                      ${u.username} ${roleBadge}
                    </div>
                    <div class="text-xs text-gray-500">${u.fullName}</div>
                  </div>
                </div>
              </td>
              <td class="p-4">
                <div class="text-sm text-gray-700 dark:text-gray-300">${u.email}</div>
                <div class="text-xs text-gray-500">${u.phone || '-'}</div>
              </td>
              <td class="p-4 font-bold text-accent whitespace-nowrap">
                Rp${u.balance.toLocaleString('id-ID')}
              </td>
              <td class="p-4">
                ${u.isActive 
                  ? '<span class="px-2 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400">Aktif</span>'
                  : '<span class="px-2 py-1 rounded-full text-xs font-semibold bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400">Suspend</span>'}
              </td>
              <td class="p-4 text-center">
                <button onclick="openModal('${u._id}', '${u.username}')" class="text-xs font-medium px-3 py-1.5 bg-gray-100 hover:bg-gray-200 dark:bg-gray-700 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-200 rounded-lg transition-colors border border-gray-200 dark:border-gray-600">
                  Edit Saldo
                </button>
              </td>
            </tr>
          `;
        });
      } else {
        tbody.innerHTML = '<tr><td colspan="5" class="p-8 text-center text-gray-500">Tidak ada user yang ditemukan.</td></tr>';
      }
    } catch (error) {
      tbody.innerHTML = '<tr><td colspan="5" class="p-8 text-center text-red-500">Gagal mengambil data.</td></tr>';
    }
  }

  searchInput.addEventListener('input', (e) => {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(() => {
      fetchUsers(e.target.value);
    }, 500);
  });

  // Modal Logic
  const modal = document.getElementById('modalAdjustment');
  const modalContent = document.getElementById('modalContent');

  function openModal(id, username) {
    document.getElementById('adjustUserId').value = id;
    document.getElementById('modalUsername').innerText = '@' + username;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    setTimeout(() => modalContent.classList.replace('scale-95', 'scale-100'), 10);
  }

  function closeModal() {
    modalContent.classList.replace('scale-100', 'scale-95');
    setTimeout(() => {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.getElementById('formAdjustBalance').reset();
    }, 200);
  }

  document.getElementById('formAdjustBalance').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('btnSubmitAdjust');
    btn.disabled = true;
    btn.innerText = 'Memproses...';

    const payload = {
      userId: document.getElementById('adjustUserId').value,
      action: document.getElementById('adjustAction').value,
      amount: document.getElementById('adjustAmount').value,
      description: document.getElementById('adjustDesc').value
    };

    try {
      const res = await axios.post('/admin/api/users/adjust-balance', payload);
      if (res.data.success) {
        showToast('success', res.data.data.message);
        closeModal();
        fetchUsers(searchInput.value); // Refresh table
      }
    } catch (error) {
      showToast('error', error.response?.data?.error?.message || 'Gagal melakukan adjustment.');
    } finally {
      btn.disabled = false;
      btn.innerText = 'Proses Adjustment';
    }
  });

  // Load awal
  document.addEventListener('DOMContentLoaded', () => fetchUsers());
</script>