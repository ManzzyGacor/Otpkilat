<script>
  // Aktifkan styling untuk path saat ini
  document.addEventListener('DOMContentLoaded', () => {
    const currentPath = window.location.pathname;
    const navItems = document.querySelectorAll('.nav-item');
    
    navItems.forEach(item => {
      if (currentPath.startsWith(item.getAttribute('data-path'))) {
        item.classList.remove('text-gray-500');
        item.classList.add('text-accent'); // Ganti dengan warna aksen
        const wrapper = item.querySelector('.icon-wrapper');
        wrapper.classList.add('bg-blue-50', 'dark:bg-blue-900/30', 'text-accent');
      }
    });
  });
</script>