<div class="space-y-6">
  <!-- Header / Saldo Card -->
  <div class="bg-gradient-to-r from-accent to-blue-500 rounded-3xl p-6 shadow-md text-white flex flex-col md:flex-row md:items-center md:justify-between relative overflow-hidden">
    <!-- Dekorasi aksen -->
    <div class="absolute -top-10 -right-10 w-40 h-40 bg-white opacity-10 rounded-full blur-2xl"></div>
    
    <div class="relative z-10">
      <p class="text-blue-100 text-sm font-medium mb-1">Total Saldo Aktif</p>
      <h2 class="text-3xl font-bold tracking-tight" id="displayBalance">
        Rp<%= typeof balance !== 'undefined' ? balance.toLocaleString('id-ID') : '0' %>
      </h2>
      <p class="text-blue-100 text-xs mt-2">Selamat datang, <%= typeof fullName !== 'undefined' ? fullName : 'Pengguna' %></p>
    </div>
    
    <div class="relative z-10 flex space-x-3 mt-6 md:mt-0">
      <a href="/deposit" class="bg-white text-accent hover:bg-gray-50 px-5 py-2.5 rounded-xl text-sm font-semibold shadow-sm transition-colors flex items-center">
        <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
        Isi Saldo
      </a>
      <a href="/order" class="bg-blue-600 border border-blue-400 text-white hover:bg-blue-700 px-5 py-2.5 rounded-xl text-sm font-semibold shadow-sm transition-colors flex items-center">
        <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
        Pesan Nomor
      </a>
    </div>
  </div>

  <!-- Announcement Section -->
  <% if (typeof announcements !== 'undefined' && announcements.length > 0) { %>
    <div class="space-y-3">
      <h3 class="text-sm font-bold text-gray-700 dark:text-gray-300 uppercase tracking-wider">Pengumuman</h3>
      <% announcements.forEach(function(ann) { %>
        <div class="p-4 rounded-2xl border 
          <%= ann.type === 'info' ? 'bg-blue-50 border-blue-200 dark:bg-blue-900/20 dark:border-blue-800' : '' %>
          <%= ann.type === 'warning' ? 'bg-yellow-50 border-yellow-200 dark:bg-yellow-900/20 dark:border-yellow-800' : '' %>
          <%= ann.type === 'danger' ? 'bg-red-50 border-red-200 dark:bg-red-900/20 dark:border-red-800' : '' %>
          <%= ann.type === 'success' ? 'bg-green-50 border-green-200 dark:bg-green-900/20 dark:border-green-800' : '' %>
        ">
          <h4 class="font-semibold text-sm mb-1 
            <%= ann.type === 'info' ? 'text-blue-800 dark:text-blue-300' : '' %>
            <%= ann.type === 'warning' ? 'text-yellow-800 dark:text-yellow-300' : '' %>
            <%= ann.type === 'danger' ? 'text-red-800 dark:text-red-300' : '' %>
            <%= ann.type === 'success' ? 'text-green-800 dark:text-green-300' : '' %>
          "><%= ann.title %></h4>
          <p class="text-sm text-gray-600 dark:text-gray-400"><%= ann.content %></p>
        </div>
      <% }); %>
    </div>
  <% } %>

  <!-- Quick Menu Grid -->
  <div>
    <h3 class="text-sm font-bold text-gray-700 dark:text-gray-300 uppercase tracking-wider mb-3">Menu Cepat</h3>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <a href="/history" class="bg-white dark:bg-gray-800 p-4 rounded-2xl border border-gray-100 dark:border-gray-700 shadow-sm flex flex-col items-center justify-center hover:border-accent transition-colors">
        <div class="w-10 h-10 rounded-full bg-indigo-50 dark:bg-indigo-900/30 text-indigo-500 flex items-center justify-center mb-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
        </div>
        <span class="text-xs font-semibold text-gray-700 dark:text-gray-300">Riwayat OTP</span>
      </a>
      
      <a href="/profile" class="bg-white dark:bg-gray-800 p-4 rounded-2xl border border-gray-100 dark:border-gray-700 shadow-sm flex flex-col items-center justify-center hover:border-accent transition-colors">
        <div class="w-10 h-10 rounded-full bg-green-50 dark:bg-green-900/30 text-green-500 flex items-center justify-center mb-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
        </div>
        <span class="text-xs font-semibold text-gray-700 dark:text-gray-300">Pengaturan</span>
      </a>
    </div>
  </div>
</div>