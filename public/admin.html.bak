<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>KilatOTP - Admin Dashboard</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    <style>
        .admin-card {
            background: linear-gradient(135deg, #000000 0%, #333333 100%);
            color: #ffffff;
            padding: 25px;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            margin-bottom: 20px;
        }
    </style>
</head>
<body>

    <div class="container" id="adminContent" style="display: none;">
        
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <h2>Admin Panel</h2>
            <button class="btn" style="width: auto; padding: 10px 15px; background: transparent; border: 1px solid var(--glass-border); color: var(--text-color);" onclick="window.location.href='/profile'">
                Kembali
            </button>
        </div>

        <!-- Cek Saldo Pusat RumahOTP -->
        <div class="admin-card">
            <h3 style="font-size: 16px; opacity: 0.8; margin-bottom: 5px;">Saldo Pusat (RumahOTP)</h3>
            <h1 id="centerBalance" style="font-size: 32px;">Mengambil data...</h1>
            <p id="centerUsername" style="font-size: 14px; opacity: 0.7; margin-top: 10px;">@admin</p>
        </div>

        <h3 style="margin-top: 30px; margin-bottom: 15px;">Konfigurasi Sistem</h3>
        
        <!-- Setup Margin & Pengumuman (Simulasi Frontend) -->
        <div class="liquid-glass" style="padding: 20px; margin-bottom: 15px;">
            <form id="settingsForm">
                <div class="form-group">
                    <label style="font-size: 14px; opacity: 0.8; margin-bottom: 8px; display: block;">Margin Profit Harga (%)</label>
                    <input type="number" id="marginProfit" placeholder="Contoh: 10" required>
                </div>
                <div class="form-group">
                    <label style="font-size: 14px; opacity: 0.8; margin-bottom: 8px; display: block;">Pengumuman Beranda (Announcement)</label>
                    <input type="text" id="announcementText" placeholder="Teks pengumuman untuk user..." required>
                </div>
                <button type="button" class="btn" onclick="saveSettings()">Simpan Konfigurasi</button>
            </form>
        </div>

    </div>

    <!-- Floating Bottom Navbar Tetap Dipertahankan -->
    <nav class="floating-nav liquid-glass">
        <a href="/" class="nav-item">
            <i class="ph ph-house"></i><span>Home</span>
        </a>
        <a href="/deposit" class="nav-item">
            <i class="ph ph-wallet"></i><span>Deposit</span>
        </a>
        <a href="/order" class="nav-item">
            <i class="ph ph-shopping-cart"></i><span>Order</span>
        </a>
        <a href="/riwayat" class="nav-item">
            <i class="ph ph-clock-counter-clockwise"></i><span>Riwayat</span>
        </a>
        <a href="/profile" class="nav-item">
            <i class="ph ph-user"></i><span>Profile</span>
        </a>
    </nav>

    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
    <script>
        const token = localStorage.getItem('token');
        if(!token) window.location.href = '/login';

        const headers = { 'Authorization': `Bearer ${token}` };

        async function verifyAdminAndFetch() {
            try {
                const res = await fetch('/api/user/admin/balance', { headers });
                const json = await res.json();
                
                if(res.status === 403 || !json.success) {
                    Toastify({ text: "Akses Ditolak!", style: { background: "#ff3b30" } }).showToast();
                    setTimeout(() => window.location.href = '/profile', 1500);
                    return;
                }

                // Jika lolos, tampilkan UI dan render saldo
                document.getElementById('adminContent').style.display = 'block';
                document.getElementById('centerBalance').innerText = json.data.formated;
                document.getElementById('centerUsername').innerText = `Akun Utama: @${json.data.username}`;
                
            } catch (err) {
                Toastify({ text: "Gagal terhubung ke API Pusat", style: { background: "#ff3b30", color: "#fff", borderRadius: "14px" } }).showToast();
            }
        }

        function saveSettings() {
            const margin = document.getElementById('marginProfit').value;
            const annc = document.getElementById('announcementText').value;
            
            // Logika menyimpan ke database (Collection Settings) bisa ditambahkan di backend
            localStorage.setItem('sys_margin', margin);
            localStorage.setItem('sys_announcement', annc);
            
            Toastify({ text: "Konfigurasi berhasil disimpan!", style: { background: "#34c759", color: "#fff", borderRadius: "14px" } }).showToast();
        }

        verifyAdminAndFetch();
    </script>
</body>
</html>