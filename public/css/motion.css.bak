:root {
  --motion-fast: 160ms;
  --motion-normal: 250ms;
  --motion-slow: 350ms;
  --ease-ios: cubic-bezier(0.22, 1, 0.36, 1);
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* Global Transition Base */
.motion-safe * {
  transition-timing-function: var(--ease-ios);
}

/* Reusable Classes */
.motion-fade {
  transition: opacity var(--motion-normal) var(--ease-ios);
}

.motion-slide-up {
  transition: transform var(--motion-normal) var(--ease-ios), opacity var(--motion-normal) var(--ease-ios);
  transform: translateY(10px);
  opacity: 0;
}
.motion-slide-up.active {
  transform: translateY(0);
  opacity: 1;
}

.motion-scale {
  transition: transform var(--motion-fast) var(--ease-ios), opacity var(--motion-fast) var(--ease-ios);
}
.motion-scale:active {
  transform: scale(0.97);
}

.motion-pop {
  transition: transform var(--motion-normal) var(--ease-spring);
}

/* Skeleton Shimmer Effect */
@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

.skeleton-shimmer {
  background: linear-gradient(90deg, rgba(229, 231, 235, 0.4) 25%, rgba(243, 244, 246, 0.8) 37%, rgba(229, 231, 235, 0.4) 63%);
  background-size: 400% 100%;
  animation: shimmer 1.5s infinite ease-in-out;
}

.dark .skeleton-shimmer {
  background: linear-gradient(90deg, rgba(55, 65, 81, 0.4) 25%, rgba(75, 85, 99, 0.8) 37%, rgba(55, 65, 81, 0.4) 63%);
  background-size: 400% 100%;
}

/* Accessibility: Reduced Motion */
@media (prefers-reduced-motion: reduce) {
  *, ::before, ::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}
