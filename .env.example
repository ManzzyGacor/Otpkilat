# ---------------------------------------------------------------
# Hanya variabel di bawah ini yang wajib diisi lewat .env.
# Konfigurasi lainnya (API key provider, Telegram, Google OAuth,
# metode pembayaran, margin, batas top up) diatur dari
# Admin Dashboard dan tersimpan di database.
# ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/kilatotp

# Kunci penandatangan sesi login. WAJIB diganti dengan string acak panjang.
SESSION_SECRET=ganti_dengan_string_acak_yang_panjang

# ---------------------------------------------------------------
# OPSIONAL: bila diisi, nilainya otomatis dipindahkan ke database
# saat server pertama kali dijalankan, lalu dikelola dari dashboard.
# ---------------------------------------------------------------
# RUMAHOTP_API_KEY=
# RUMAHOTP_BASE_URL=https://www.rumahotp.io/api
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# GITHUB_TOKEN=
# GITHUB_OWNER=
# GITHUB_REPO=
